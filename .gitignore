# ============================================================
# .gitignore —— 告诉 Git 哪些文件不要上传
# 2026-10-10 创建
# ============================================================

# ---------- 敏感信息（绝对不能上传）----------
config.py
.env
*.key
*密钥*

# ---------- 大文件（GitHub 单文件上限 100MB，超过就传不上去）----------
data/processed/专利明细.csv
data/processed/企业财务数据_full.csv
data/raw/
*.rar
*.zip

data/llm/抽查_原文与打分_v4.csv
data/llm/抽查_原文与打分_v3.csv

# ---------- 原始专利数据（152 个 Excel，共约 340MB）----------
*.xlsx
专利数据/

# ---------- Python 运行产物 ----------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# ---------- 编辑器/系统 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---------- 临时文件 ----------
_preview/
*.tmp
~$*
